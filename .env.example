BOT_TOKEN=123456:ABC-ضع-التوكن-بتاعك-هنا
# حط الـ Telegram ID بتاعك (جيبه من @userinfobot). لو أكتر من أدمن افصل بفاصلة: 111,222
ADMIN_IDS=123456789
# حد الإرسال (تليجرام Bot API = 50MB)
MAX_FILE_MB=50
# مفتاح Gemini من https://aistudio.google.com/app/apikey (اختياري — بدونه قسم الذكاء معطل)
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash
# مجلد الملفات المؤقتة
TEMP_DIR=/tmp/islambot
